#!/usr/bin/env bash
set -euo pipefail

# Keep KDE's native secure Plasma Keyboard for the desktop, lock screen, and
# SDDM. Plasma handles the language key through its own external popup, so a
# style override alone cannot reliably change the behavior. Instead, derive an
# update-safe copy of Plasma's layouts and make each ChangeLanguageKey cycle
# directly through the enabled locales.

PLASMA_KEYBOARD_EXECUTABLE="${VBOARD_PLASMA_KEYBOARD_EXECUTABLE:-/usr/bin/plasma-keyboard}"

find_plasma_layouts() {
  if [[ -n "${VBOARD_PLASMA_LAYOUTS_SOURCE+x}" ]]; then
    if [[ -d "$VBOARD_PLASMA_LAYOUTS_SOURCE" ]]; then
      printf '%s\n' "$VBOARD_PLASMA_LAYOUTS_SOURCE"
      return 0
    fi
    return 1
  fi

  local candidate
  for candidate in \
    /usr/local/share/plasma/keyboard/layouts \
    /usr/share/plasma/keyboard/layouts; do
    if [[ -d "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

SOURCE_LAYOUTS="$(find_plasma_layouts || true)"
if [[ -z "$SOURCE_LAYOUTS" ]]; then
  echo "vboard: Plasma Keyboard layouts were not found; using the system defaults" >&2
  exec "$PLASMA_KEYBOARD_EXECUTABLE" "$@"
fi

CACHE_BASE="${XDG_CACHE_HOME:-${HOME}/.cache}"
DATA_ROOT="$CACHE_BASE/vboard/plasma-keyboard/data"
LAYOUT_PARENT="$DATA_ROOT/plasma/keyboard"
TARGET_LAYOUTS="$LAYOUT_PARENT/layouts"
SOURCE_STAMP="$LAYOUT_PARENT/source-path"
SIGNATURE_STAMP="$LAYOUT_PARENT/source-signature"

SOURCE_SIGNATURE="$(
  find "$SOURCE_LAYOUTS" -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    | sha256sum \
    | cut -d' ' -f1
)"

REFRESH_LAYOUTS=0
if [[ ! -d "$TARGET_LAYOUTS" || ! -f "$SOURCE_STAMP" \
      || ! -f "$SIGNATURE_STAMP" ]]; then
  REFRESH_LAYOUTS=1
elif [[ "$(<"$SOURCE_STAMP")" != "$SOURCE_LAYOUTS" \
        || "$(<"$SIGNATURE_STAMP")" != "$SOURCE_SIGNATURE" ]]; then
  REFRESH_LAYOUTS=1
fi

if [[ "$REFRESH_LAYOUTS" -eq 1 ]]; then
  mkdir -p "$LAYOUT_PARENT"
  TEMP_LAYOUTS="$LAYOUT_PARENT/.layouts.$$"
  mkdir -p "$TEMP_LAYOUTS"
  cp -a "$SOURCE_LAYOUTS/." "$TEMP_LAYOUTS/"

  PATCH_COUNT=0
  while IFS= read -r -d '' layout_file; do
    if grep -Eq '^[[:space:]]*ChangeLanguageKey[[:space:]]*\{' "$layout_file"; then
      sed -i -E \
        '/^[[:space:]]*ChangeLanguageKey[[:space:]]*\{/a\            onClicked: keyboard.changeInputLanguage(customLayoutsOnly)' \
        "$layout_file"
      PATCH_COUNT=$((PATCH_COUNT + 1))
    fi
  done < <(find "$TEMP_LAYOUTS" -type f -name '*.qml' -print0)

  if [[ "$PATCH_COUNT" -eq 0 ]]; then
    rm -rf "$TEMP_LAYOUTS"
    echo "vboard: no Plasma language keys were found; using the system layouts" >&2
    exec "$PLASMA_KEYBOARD_EXECUTABLE" "$@"
  fi

  rm -rf "$TARGET_LAYOUTS"
  mv "$TEMP_LAYOUTS" "$TARGET_LAYOUTS"
  printf '%s\n' "$SOURCE_LAYOUTS" >"$SOURCE_STAMP"
  printf '%s\n' "$SOURCE_SIGNATURE" >"$SIGNATURE_STAMP"
fi

if [[ "${1:-}" == "--prepare-layouts" || "${1:-}" == "--prepare-style" ]]; then
  printf '%s\n' "$TARGET_LAYOUTS"
  exit 0
fi

# Plasma Keyboard's initLayoutsPath() selects the first
# $XDG_DATA_HOME/plasma/keyboard/layouts directory it finds. Point only this
# process at the derived tree; system layouts and files remain untouched.
export XDG_DATA_HOME="$DATA_ROOT"

exec "$PLASMA_KEYBOARD_EXECUTABLE" "$@"
